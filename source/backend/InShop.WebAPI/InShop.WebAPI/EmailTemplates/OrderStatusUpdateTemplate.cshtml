@using InShopBLLayer.Models
@model OrderEmailTemplateModel

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    body {
      margin: 0;
      padding: 24px 12px;
      background-color: #f8f9fa;
      font-family: Arial, Helvetica, sans-serif;
      color: #000000;
    }
    .wrap {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border: 2px solid #000000;
    }
    .header {
      background: #000000;
      color: #ffffff;
      padding: 28px 24px;
      text-align: center;
      border-bottom: 2px solid #000000;
    }
    .eyebrow {
      margin: 0 0 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.75;
    }
    .header h1 {
      margin: 0;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.3;
    }
    .content {
      padding: 24px;
    }
    .meta {
      margin: 0 0 8px;
      font-size: 14px;
      line-height: 1.5;
    }
    .status {
      display: inline-block;
      margin: 8px 0 20px;
      padding: 8px 14px;
      border: 2px solid #000000;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .section-title {
      margin: 0 0 12px;
      padding-bottom: 8px;
      border-bottom: 2px solid #000000;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .item {
      padding: 12px 0;
      border-bottom: 1px solid #000000;
    }
    .item:last-child {
      border-bottom: none;
    }
    .item-name {
      margin: 0 0 4px;
      font-weight: 700;
      font-size: 14px;
    }
    .item-quantity {
      margin: 0;
      color: #555555;
      font-size: 13px;
    }
    .total {
      margin: 16px 0 0;
      padding-top: 14px;
      border-top: 2px solid #000000;
      font-size: 16px;
      font-weight: 700;
      text-align: right;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .cta-wrap {
      text-align: center;
      margin: 28px 0 12px;
    }
    .cta {
      display: inline-block;
      background: #000000;
      color: #ffffff !important;
      text-decoration: none;
      padding: 14px 28px;
      border: 2px solid #000000;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .link-fallback {
      text-align: center;
      color: #555555;
      font-size: 12px;
      line-height: 1.5;
      word-break: break-all;
    }
    .link-fallback a {
      color: #000000;
    }
    .thanks {
      margin: 24px 0 0;
      font-size: 14px;
    }
    .footer {
      text-align: center;
      padding: 16px 24px 24px;
      color: #666666;
      font-size: 12px;
      border-top: 2px solid #000000;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <p class="eyebrow">InShop</p>
      <h1>@Model.Headline</h1>
    </div>
    <div class="content">
      <p class="meta">Дата заказа: @Model.OrderDate</p>
      <div class="status">@Model.StatusDisplayName</div>

      <h2 class="section-title">Состав заказа</h2>
      <div class="items-list">
        @foreach (var item in Model.OrderItems)
        {
          <div class="item">
            <p class="item-name">@item.ProductName</p>
            <p class="item-quantity">@item.QuantityItem шт. × @item.Price = @item.TotalPrice</p>
          </div>
        }
      </div>

      <p class="total">Итого: @Model.OrderTotalAmount</p>

      @if (!string.IsNullOrWhiteSpace(Model.TrackingUrl))
      {
        <div class="cta-wrap">
          <a class="cta" href="@Model.TrackingUrl">Отследить заказ</a>
        </div>
        <p class="link-fallback">
          Или откройте ссылку:<br />
          <a href="@Model.TrackingUrl">@Model.TrackingUrl</a>
        </p>
      }

      <p class="thanks">Спасибо за покупку!</p>
    </div>
    <div class="footer">
      &copy; @DateTime.UtcNow.Year InShop. Все права защищены.
    </div>
  </div>
</body>
</html>
